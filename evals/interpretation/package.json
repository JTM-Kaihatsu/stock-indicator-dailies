{
  "name": "@stock-indicator-dailies/eval-interpretation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interpretation eval: grade the VLM's chart reading against a computed oracle.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eval": "node --env-file-if-exists=../../.env.local run-eval.ts",
    "capture-images": "node capture-images.ts",
    "analyze-saved": "node --env-file-if-exists=../../.env.local analyze-saved.ts",
    "score-truth": "node score-truth.ts"
  },
  "dependencies": {
    "@stock-indicator-dailies/shared": "*",
    "@stock-indicator-dailies/agent": "*",
    "@stock-indicator-dailies/indicators": "*",
    "@stock-indicator-dailies/vlm": "*"
  }
}
