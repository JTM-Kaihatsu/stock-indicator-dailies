# Stock Indicator Dailies; environment template
# Copy to .env.local and fill in. NEVER commit the filled-in file.

# --- AI layer: frontier VLM (Claude / Gemini / GPT-class) ---
# Provider is pluggable; set the one you're using and its key.
VLM_PROVIDER=claude
VLM_MODEL=claude-sonnet-5
# For Claude: create a key at https://console.anthropic.com → API keys.
VLM_API_KEY=

# --- Database: Supabase ---
# The URL + anon key are safe for the browser: no table (chart_cache,
# advisor_cache, watchlist_tickers) grants anon/authenticated any access,
# so apps/web's client only ever uses these for supabase.auth.* calls
# (optional magic-link login), never to query a table directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (apps/api's caches, and verifying a logged-in user's
# JWT for watchlist routes). Same project as above, but not
# NEXT_PUBLIC_-prefixed; apps/api isn't a Next.js app and this key bypasses
# RLS, so it must never reach a browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agentic layer: charting provider ---
# Preferred: OAuth / scoped read-only API keys over raw passwords.
# For local dev only; production credentials belong in an OS-level vault (Keychain),
# not in this file. See docs/ARCHITECTURE.md#security--risk.
CHART_PROVIDER=tradingview
CHART_PROVIDER_USERNAME=
CHART_PROVIDER_PASSWORD=

# --- Agent behavior ---
# Human-like interaction timing + rate limiting to avoid bot mitigation / account suspension.
AGENT_HEADLESS=true
AGENT_MIN_ACTION_DELAY_MS=400
AGENT_MAX_ACTION_DELAY_MS=1200

# --- API server (Hono, runs on Render) ---
PORT=3001
# Unset/false in production. Gates a manual scheduler-trigger endpoint
# (POST /api/watchlist/dev/run-scheduler-now) used to verify the 7am ET
# watchlist sweep without waiting for it to actually be 7am ET.
ENABLE_DEV_ENDPOINTS=false

# --- Web frontend (Next.js, runs on Vercel) ---
# In dev: point directly at the local Hono API server.
NEXT_PUBLIC_API_URL=http://localhost:3001
# In production: server-side only, Vercel proxy → Render service.
PIPELINE_API_URL=
